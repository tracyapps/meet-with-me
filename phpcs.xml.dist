<?xml version="1.0"?>
<ruleset name="Meet With Me">
	<description>PHP_CodeSniffer ruleset for the Meet With Me plugin.</description>

	<file>.</file>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/bin/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Check up to 8 files simultaneously. -->
	<arg name="parallel" value="8"/>

	<!-- Rules: WordPress Coding Standards. -->
	<rule ref="WordPress"/>

	<!-- ======================================================================
		Deliberate deviations from the full WordPress standard, documented so
		they read as decisions rather than oversights. Revisit at 1.0.
	====================================================================== -->

	<!-- Docblocks are written voluntarily; WPCS's mandatory-docblocks policy
	     (file headers with @package, full param/return tags everywhere) is
	     more ceremony than value for this codebase pre-1.0. -->
	<rule ref="Squiz.Commenting.FileComment">
		<exclude name="Squiz.Commenting.FileComment.MissingPackageTag"/>
		<exclude name="Squiz.Commenting.FileComment.Missing"/>
		<exclude name="Squiz.Commenting.FileComment.SpacingAfterComment"/>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment">
		<exclude name="Squiz.Commenting.FunctionComment.Missing"/>
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamComment"/>
		<exclude name="Squiz.Commenting.FunctionComment.WrongStyle"/>
		<exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
	</rule>
	<rule ref="Squiz.Commenting.VariableComment">
		<exclude name="Squiz.Commenting.VariableComment.Missing"/>
	</rule>
	<rule ref="Squiz.Commenting.InlineComment">
		<exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
	</rule>

	<!-- Yoda conditions and short ternaries are legacy-style requirements;
	     this codebase uses natural comparison order and ?: deliberately. -->
	<rule ref="WordPress.PHP.YodaConditions">
		<exclude name="WordPress.PHP.YodaConditions.NotYoda"/>
	</rule>
	<rule ref="Universal.Operators.DisallowShortTernary">
		<exclude name="Universal.Operators.DisallowShortTernary.Found"/>
	</rule>

	<!-- Direct $wpdb queries (properly prepared) are the plugin's storage
	     design; requiring object caching on every query is out of scope. -->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
		<exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
	</rule>

	<!-- "mwm" is the plugin's historical 3-character prefix; renaming every
	     global for the length rule isn't worth the churn. The prefix check
	     itself still runs. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed">
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed"/>
	</rule>

	<!-- Admin list screens read $_GET filters for display; nonce checks guard
	     the state-changing save handlers, which NonceVerification.Missing
	     still enforces. -->
	<rule ref="WordPress.Security.NonceVerification.Recommended">
		<exclude name="WordPress.Security.NonceVerification.Recommended"/>
	</rule>

	<!-- block-editor.asset.php is the filename convention WordPress block
	     tooling generates and expects; keep it out of the FileName sniff. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/blocks/*/*.asset.php</exclude-pattern>
	</rule>

	<!-- Security sniffs that stay fully enforced (no exclusions):
	     WordPress.Security.ValidatedSanitizedInput, Missing nonce checks,
	     EscapeOutput, PreparedSQL. -->

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="meet-with-me"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="mwm"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_supported_wp_version" value="6.4"/>
	<config name="testVersion" value="8.1-"/>
</ruleset>
